{
  "manifest_version": 3,
  "name": "TAVY AI Scraper Pro",
  "version": "21.0",
  "description": "TAVY AI Scraper v21.0 DEV - Developer Mode HUD, 50+ Ảnh Đánh Giá GDAS, Album Studio HD & Infographic Mô Tả, Batch Scrape Queue, Dịch Thuật Gemini AI Độc Quyền",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "*://*.oliveyoung.co.kr/*",
    "https://generativelanguage.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "https://tavyorder.web.app/*",
    "https://oderho.vercel.app/*",
    "http://localhost/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.oliveyoung.co.kr/*"],
      "js": ["content.js"]
    },
    {
      "matches": [
        "https://tavyorder.web.app/admin/*",
        "https://tavyorder.web.app/*",
        "https://oderho.vercel.app/admin/*",
        "https://oderho.vercel.app/*",
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["admin-content-script.js"]
    }
  ]
}

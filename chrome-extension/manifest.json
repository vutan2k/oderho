{
  "manifest_version": 3,
  "name": "Tavy Order - Olive Young Scraper (v3.3)",
  "version": "3.3",
  "description": "Cào dữ liệu sản phẩm Olive Young + Status Indicator 🟢/🔴 (V3.3 Ready)",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://*.oliveyoung.co.kr/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.oliveyoung.co.kr/*"],
      "js": ["content.js"]
    }
  ]
}

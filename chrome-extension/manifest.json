{
  "manifest_version": 3,
  "name": "tavy-toolcaowed",
  "version": "6.0",
  "description": "Tiện ích cào dữ liệu sản phẩm & Tự động cào Ranking Top 50 AI Pro v6.0",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "*://*.oliveyoung.co.kr/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.oliveyoung.co.kr/*"],
      "js": ["content.js"]
    }
  ]
}

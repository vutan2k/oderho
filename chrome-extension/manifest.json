{
  "manifest_version": 3,
  "name": "Tavy Order - Olive Young Scraper (v3.2)",
  "version": "3.2",
  "description": "Cào dữ liệu sản phẩm Olive Young + Album Ảnh Thật & Review (V3.2 Anti-Hang Guard)",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://*.oliveyoung.co.kr/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.oliveyoung.co.kr/*"],
      "js": ["content.js"]
    }
  ]
}
